APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AI salespage copy generation ---
# Provider for the TEXT copy: 'claude' (Anthropic Messages API, billed to
# Amar's Max-plan monthly credits) or 'openrouter' (fallback). Claude is used
# only when AI_PROVIDER=claude AND ANTHROPIC_API_KEY is set; otherwise it
# falls back to OpenRouter, then to the local mock.
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_VERSION=2023-06-01
# AI_TIMEOUT=120
# CLAUDE_MAX_TOKENS=8000
#
# OpenRouter: still REQUIRED for image generation + image/vision analysis
# (Google Gemini models) even when text runs on Claude. Also the text fallback.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# --- WhatsApp (WAHA) notifications ---
WAHA_URL=https://waha.129-212-216-31.sslip.io
WAHA_API_KEY=
WAHA_SESSION=amarbedaie
WAHA_DEFAULT_CC=60
WHATSAPP_NOTIFICATIONS_ENABLED=false
MENDAP_ADMIN_WHATSAPP=

# --- Provisioning: auto-grant access on a BeDaie system after payment ---
# The SAME key pair is configured on every target system. See docs/provisioning.md.
PROVISIONING_ENABLED=false
PROVISIONING_API_KEY=
PROVISIONING_SIGNING_SECRET=
PROVISIONING_TIMEOUT=20
# Override a target URL only when its domain differs from config/provisioning.php,
# e.g. PROVISION_URL_DARAH_WANITA=https://darahwanita.com/api/provision
