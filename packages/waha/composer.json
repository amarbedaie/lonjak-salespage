{
    "name": "amarbedaie/waha",
    "description": "Minimal WAHA (WhatsApp HTTP API) client for Laravel apps.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "autoload": {
        "psr-4": { "Waha\\": "src/" }
    },
    "require": {
        "php": "^8.3",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0"
    },
    "extra": {
        "laravel": {
            "providers": ["Waha\\WahaServiceProvider"]
        }
    },
    "minimum-stability": "stable"
}
